{
  "expo": {
    "name": "FlowDay",
    "slug": "flowday",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/icons/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f11"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iamhuitron.flowday"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/icon.png",
        "backgroundColor": "#0f0f11"
      },
      "package": "com.iamhuitron.flowday"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "baseUrl": "/flowday",
      "favicon": "./src/assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icons/notification-icon.png",
          "color": "#7c6aff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildToolsVersion": "34.0.0",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "kotlinVersion": "1.9.24",
            "newArchEnabled": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "flowday",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b2ad3083-2c4e-4dac-b853-c2e553f45ed3"
      }
    }
  }
}